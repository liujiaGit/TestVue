<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.testvue.mapper.SysUserMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.example.testvue.entity.SysUser">
        <id column="id" property="id" />
        <result column="user_no" property="userNo" />
        <result column="photo" property="photo" />
        <result column="user_name" property="userName" />
        <result column="pwd" property="pwd" />
        <result column="token" property="token" />
        <result column="role" property="role" />
        <result column="status" property="status" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, user_no, photo, user_name, C, role, status
    </sql>

    <select id="findAll" resultType="com.example.testvue.entity.SysUser">
        select * from sys_user
    </select>
    <select id="login" resultType="com.example.testvue.entity.SysUser"
            parameterType="com.example.testvue.entity.SysUser">
        select a.*,b.disc_name as role_name from sys_user a,sys_disc b
        where
            a.user_name=#{userName}
          and a.pwd = #{pwd}
          and b.disc_no = a.role
    </select>

    <insert id="insert" parameterType="com.example.testvue.entity.SysUser">
        insert into sys_user
        (user_no,photo,user_name,pwd,role,status)
        values
        (#{userNo},#{photo}, #{userName}, #{pwd}, #{role}, #{status})
    </insert>
    <delete id="deleteById" parameterType="com.example.testvue.entity.SysUser">
        delete from sys_user where id = #{id}
    </delete>

    <update id="updateById" parameterType="java.lang.Integer">
        update sys_user set
        <if test="userNo !='' and userNo !=null ">
            user_no = #{userNo}
        </if>
        <if test="photo !='' and photo !=null ">
            photo = #{photo}
        </if>
        <if test="userName !='' and userName !=null ">
            user_name = #{userName}
        </if>
        <if test="pwd !='' and pwd !=null ">
            pwd = #{pwd}
        </if>
        <if test="role !='' and role !=null ">
            role = #{role}
        </if>
        <if test="status !='' and status !=null ">
            status = #{status}
        </if>
    </update>
</mapper>
