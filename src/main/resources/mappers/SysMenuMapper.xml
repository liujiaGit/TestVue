    </insert>
    <update id="updateById">
        update sys_menu set
            <if test="sysMenu.parentId !='' and sysMenu.parentId != null">
                parent_id = sysMenu.parentId
            </if>
        <if test="sysMenu.redirect !='' and sysMenu.redirect != null">
            redirect = sysMenu.redirect
        </if>
        <if test="sysMenu.menuName !='' and sysMenu.menuName != null">
            menu_name = sysMenu.menuName
        </if>
        <if test="sysMenu.path !='' and sysMenu.path != null">
            path = sysMenu.path
        </if>
        <if test="sysMenu.component !='' and sysMenu.component != null">
            component = sysMenu.component
        </if>
        <if test="sysMenu.icon !='' and sysMenu.icon != null">
            icon = sMenu.icon
        </if>
        <if test="sysMenu.authority !='' and sysMenu.authority != null">
            authority = sysMenu.authority
        </if>
        where id=#{sysMenu.id}
    </update>
    <select id="list" resultType="com.example.testvue.entity.SysMenu">
        select * from sys_menu
    </select>

</mapper>
