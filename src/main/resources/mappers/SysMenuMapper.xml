<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.testvue.mapper.SysMenuMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.example.testvue.entity.SysMenu">
        <id column="id" property="id" />
        <result column="menu_id" property="menuId" />
        <result column="parent_id" property="parentId" />
        <result column="redirect" property="redirect" />
        <result column="menu_name" property="menuName" />
        <result column="path" property="path" />
        <result column="component" property="component" />
        <result column="icon" property="icon" />
        <result column="authority" property="authority" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, menu_id, parent_id, redirect, menu_name, path, component, icon, authority
    </sql>
    <insert id="save" parameterType="com.example.testvue.entity.SysMenu">
        insert into sys_menu
        (id,menu_id,parent_id,redirect,menu_name,path,component,icon,authority)
        values
        (#{id}, #{menuId}, #{parentId}, #{redirect}, #{menuName}, #{path}, #{component}, #{icon}, #{authority})
    </insert>
    <update id="updateById">
        update sys_menu set
            <if test="parentId !='' and parentId != null">
                parent_id = #{parentId}
            </if>
        <if test="redirect !='' and redirect != null">
            redirect = #{redirect}
        </if>
        <if test="menuName !='' and menuName != null">
            menu_name = #{menuName}
        </if>
        <if test="path !='' and path != null">
            path = #{path}
        </if>
        <if test="component !='' and component != null">
            component = #{component}
        </if>
        <if test="icon !='' and icon != null">
            icon = #{sMenu.icon}
        </if>
        <if test="authority !='' and authority != null">
            authority = #{authority}
        </if>
        where id=#{id}
    </update>
    <select id="list" resultType="com.example.testvue.entity.SysMenu">
        select * from sys_menu
    </select>

</mapper>
